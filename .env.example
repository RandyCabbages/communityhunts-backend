# Discord OAuth
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_CALLBACK_URL=https://your-railway-url.up.railway.app/auth/discord/callback

# Session
SESSION_SECRET=your_long_random_secret_here

# Developer API — keys the opaque `owner.id` returned by /api/public/v1/hunts. Set it ONCE and
# never rotate it: consumers store that id as a foreign key, and changing this silently renames
# every owner the API has ever reported. Falls back to SESSION_SECRET (with a startup warning),
# which is a secret we DO rotate — hence the separate var.
PUBLIC_ID_SECRET=another_long_random_secret_here

# Database (Railway provides this automatically)
DATABASE_URL=your_postgres_url

# Frontend URL (for CORS + redirects)
FRONTEND_URL=https://your-vercel-url.vercel.app

# Twitch (for live detection)
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# Discord guild role detection — REQUIRED for any tenant that sets requiredRoles (e.g. Bean's
# 'affiliate' gate). Without these, role detection can't run and affiliate/vip/mod come back
# UNDETERMINED: role-gated tenants then fall OPEN (any signed-in user gets in) rather than
# locking everyone out. Set all of them to enforce the gate. GUILD_ID is the Discord server
# whose roles matter (the community server, NOT the business server); the ROLE_IDs are that
# server's role IDs (Discord → Server Settings → Roles → right-click → Copy Role ID).
DISCORD_GUILD_ID=your_discord_guild_id
DISCORD_AFFILIATE_ROLE_ID=your_affiliate_role_id
DISCORD_VIP_ROLE_ID=your_vip_role_id
DISCORD_MOD_ROLE_ID=your_mod_role_id

# Channel the community bot (DISCORD_BOT_TOKEN) posts site announcements into when an owner
# publishes with "Post to Discord" on. Optional — blank means announcements never cross-post.
# The bot needs Send Messages + Embed Links in this channel.
DISCORD_ANNOUNCEMENTS_CHANNEL_ID=your_announcements_channel_id

# POST /api/tickets posts inquiries + feature suggestions into the communityhunts.gg Discord via
# the shared DISCORD_BOT_TOKEN bot (the same single bot used by announcements + Shop Requests).
# Type "Feature Request" → suggestions channel; Bug/Other/Community Request → tickets channel.
# Channel IDs: enable Developer Mode, right-click channel → Copy ID.
# NOTE: DISCORD_TICKETS_BOT_TOKEN is retired/unused — all Discord posting now uses DISCORD_BOT_TOKEN.
DISCORD_TICKETS_CHANNEL_ID=your_inquiries_channel_id
DISCORD_SUGGESTIONS_CHANNEL_ID=your_suggestions_channel_id
# Dedicated channel for custom-card commission requests ("Shop Requests"), served by DISCORD_BOT_TOKEN.
DISCORD_SHOP_REQUESTS_CHANNEL_ID=

# ── Stripe ────────────────────────────────────────────────────────────────────
# Blank STRIPE_SECRET_KEY disables Stripe entirely (lib/stripe.js logs and no-ops) — fine
# locally, fatal in production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# REQUIRED IN PRODUCTION — the individual MONTHLY plans. Unlike every other price map in
# lib/stripe.js these have NO hardcoded fallback, so if any one is missing or stale,
# createCheckoutSession throws "Price not configured for tier: <tier>" and monthly checkout
# fails for every user while ANNUAL keeps working — which reads as a payment glitch, not a
# config error. Verify all three in Railway whenever prices change.
#   basic $9.99/mo · pro $19.99/mo · ultimate $39.99/mo
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ULTIMATE=price_...

# Individual ANNUAL and both COMMUNITY maps are hardcoded in lib/stripe.js and only need an
# env var here to OVERRIDE them. Leave blank unless you are repricing.
STRIPE_PRICE_COMMUNITY_PRO=
STRIPE_PRICE_COMMUNITY_PARTNER=
STRIPE_PRICE_COMMUNITY_PRO_ANNUAL=
STRIPE_PRICE_COMMUNITY_PARTNER_ANNUAL=

# Paid standalone browser extension ($14.99). Without it POST /api/extension/subscribe
# returns 503 "Extension subscription not configured yet".
STRIPE_PRICE_EXT_FULL=
STRIPE_PRICE_EXT_FULL_ANNUAL=

# Optional overrides
ADMINS=bean,randycabbage,randy cabbage,mcflurry,mihallimou,missingiscool,cuda
VIP_HOSTS=bean,mcflurry,mihallimou,missingiscool,cuda,randycabbage
