# Discord OAuth
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_CALLBACK_URL=https://your-railway-url.up.railway.app/auth/discord/callback

# Session
SESSION_SECRET=your_long_random_secret_here

# Database (Railway provides this automatically)
DATABASE_URL=your_postgres_url

# Frontend URL (for CORS + redirects)
FRONTEND_URL=https://your-vercel-url.vercel.app

# Twitch (for live detection)
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# Discord guild role detection — REQUIRED for any tenant that sets requiredRoles (e.g. Bean's
# 'affiliate' gate). Without these, role detection can't run and affiliate/vip/mod come back
# UNDETERMINED: role-gated tenants then fall OPEN (any signed-in user gets in) rather than
# locking everyone out. Set all of them to enforce the gate. GUILD_ID is the Discord server
# whose roles matter (the community server, NOT the business server); the ROLE_IDs are that
# server's role IDs (Discord → Server Settings → Roles → right-click → Copy Role ID).
DISCORD_GUILD_ID=your_discord_guild_id
DISCORD_AFFILIATE_ROLE_ID=your_affiliate_role_id
DISCORD_VIP_ROLE_ID=your_vip_role_id
DISCORD_MOD_ROLE_ID=your_mod_role_id

# Optional overrides
ADMINS=bean,randycabbage,randy cabbage,mcflurry,mihallimou,missingiscool,cuda
VIP_HOSTS=bean,mcflurry,mihallimou,missingiscool,cuda,randycabbage
