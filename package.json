{
  "name": "communityhunts-backend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch -r dotenv/config server.js",
    "test": "node --test lib/*.test.js routes/*.test.js",
    "test:lib": "node --test lib/*.test.js",
    "test:routes": "node --test routes/*.test.js",
    "postinstall": "patchright install --with-deps chromium || true"
  },
  "engines": {
    "node": ">=20 <25"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "connect-pg-simple": "^9.0.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "helmet": "^8.2.0",
    "passport": "^0.7.0",
    "passport-discord": "^0.1.4",
    "patchright": "^1.61.1",
    "pg": "^8.11.3",
    "puppeteer": "^22.0.0",
    "puppeteer-extra": "^3.3.6",
    "socket.io": "^4.7.4",
    "stripe": "^22.3.0"
  }
}
