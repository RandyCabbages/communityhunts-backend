# scripts/dedupe_rainbet_slots.js scratch — its header says neither file is committed, but
# nothing enforced that, so both sat in `git status` as untracked bait next to a file the
# script rewrites. Note rainbet_slots.json itself IS tracked (auto-committed by rainbetSlotSync).
dedupe_plan.json
dedupe_live_cache.json
# Atomic-write temp files (lib/persistence.js writeFileAtomic) — normally renamed away
# instantly, but a hard kill mid-write can strand one.
*.tmp

